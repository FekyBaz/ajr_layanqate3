# أجر لا ينقطع - Environment Variables
# Copy this file to .env and replace every placeholder with your own values.
# NEVER commit real secrets or production credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

ADMIN_API_KEY=

FRONTEND_URL=http://localhost:8888
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8888

RATE_LIMIT_WINDOW=24
RATE_LIMIT_MAX=10
MEMORY_RATE_LIMIT_MAX=3
MEMORY_RATE_LIMIT_HOURS=24
RATE_LIMIT_WINDOW_HOURS=24
RATE_LIMIT_MAX_REQUESTS=10

# Used to hash IP-derived rate-limit identifiers.
# REQUIRED in production: without it all deployments share one unsalted bucket.
# Generate with: openssl rand -hex 32
IP_SALT=

# Optional Google Analytics 4
GA_MEASUREMENT_ID=
