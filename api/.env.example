# أجر لا ينقطع - Environment Variables
# Copy this file to .env and replace every placeholder with your own values.
# NEVER commit real secrets or production credentials.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

FRONTEND_URL=http://localhost:8888
NODE_ENV=development
# Comma-separated extra CORS origins (merged with FRONTEND_URL + localhost).
# Example: ALLOWED_ORIGINS=https://ajr-la-yanqati.com,https://www.ajr-la-yanqati.com
ALLOWED_ORIGINS=http://localhost:8888

# Admin auth: at least one must be set (ADMIN_API_KEY preferred).
ADMIN_API_KEY=
# ADMIN_KEY=
# Admin flood threshold: max admin attempts per ADMIN window (default 300/1h).
ADMIN_RATE_LIMIT_MAX=300

# Submission rate limits (atomic RPCs): max requests per window.
RATE_LIMIT_WINDOW=24
RATE_LIMIT_MAX=10
MEMORY_RATE_LIMIT_MAX=3
MEMORY_RATE_LIMIT_HOURS=24
# Memorial update proposals: max per window.
MEMORY_UPDATE_RATE_LIMIT_MAX=5
MEMORY_UPDATE_RATE_LIMIT_HOURS=24
# Memorial interaction debounce (seconds between counted interactions).
MEMORY_INTERACTION_DEBOUNCE=30

# Used to hash IP-derived rate-limit identifiers.
# REQUIRED in production: without it all deployments share one unsalted bucket.
# Generate with: openssl rand -hex 32
IP_SALT=

# Deploy-preview allow-listing (CORS): your Netlify site name, e.g. ajr-la-yanqati.
NETLIFY_SITE_NAME=

# Site timezone for the daily boundary (IANA name, default Asia/Gaza).
TIMEZONE=Asia/Gaza

# Logging: debug | info | warn | error (default info).
LOG_LEVEL=info

# Optional admin Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Google Analytics 4 (client measurement ID served by /api/ga-config).
GA_MEASUREMENT_ID=
# Optional server-side GA4 (analytics dashboard): property ID + one credential set.
GA4_PROPERTY_ID=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# Or OAuth triplet:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
